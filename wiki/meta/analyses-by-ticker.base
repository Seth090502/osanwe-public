# wiki/meta/analyses-by-ticker.base
# Entity ## Analyses section embeds ![[wiki/meta/analyses-by-ticker.base#<TKR>]]
# View name = bare ticker symbol (matches canary convention).

filters:
  - file.inFolder("wiki/investing/analyses")
  - type == "analysis"

views:
  - type: table
    name: NVDA
    filters: [file.tags.contains("ticker/NVDA")]
    order: [file.name, confidence, updated]
    sort:
      - column: updated
        direction: DESC
  - type: table
    name: AMD
    filters: [file.tags.contains("ticker/AMD")]
    order: [file.name, confidence, updated]
    sort:
      - column: updated
        direction: DESC
